<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:paddingBottom="@dimen/padding_xlarge">

    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/banner_height"
        android:layout_marginTop="@dimen/dp_72"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/spiderman_banner" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="@dimen/dp_28"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detail_title"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <ImageView
        android:id="@+id/btnBookmark"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginTop="@dimen/dp_28"
        android:layout_marginEnd="@dimen/margin_large"
        android:src="@drawable/ic_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardPoster"
        android:layout_width="@dimen/poster_width"
        android:layout_height="@dimen/poster_height"
        android:layout_marginStart="@dimen/margin_large"
        app:cardCornerRadius="@dimen/corner_radius_default"
        app:layout_constraintBottom_toBottomOf="@id/imgBanner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgBanner">

        <ImageView
            android:id="@+id/imgPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@drawable/spiderman_poster" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/margin_medium"
        android:layout_marginBottom="@dimen/margin_medium"
        android:background="@drawable/button_blue_rounded"
        android:backgroundTint="@color/background_dark"
        android:drawablePadding="@dimen/padding_ssmall"
        android:drawableStart="@drawable/ic_star"
        android:paddingHorizontal="@dimen/padding_small"
        android:paddingVertical="@dimen/dp_4"
        android:text=""
        android:textColor="@color/rating_orange"
        android:textSize="@dimen/text_size_small"
        app:layout_constraintBottom_toBottomOf="@id/imgBanner"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvMovieTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_medium"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginEnd="@dimen/margin_large"
        android:text=""
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardPoster"
        app:layout_constraintTop_toBottomOf="@id/imgBanner" />

    <LinearLayout
        android:id="@+id/layoutMovieInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_large"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardPoster">

        <TextView
            android:id="@+id/tvInfoYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_4"
            android:drawableStart="@drawable/calendarblank"
            android:text=""
            android:textColor="@color/text_secondary_gray"
            android:textSize="@dimen/text_size_small" />

        <View
            android:id="@+id/dividerYearDuration"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_14"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:background="@color/text_secondary_gray" />

        <TextView
            android:id="@+id/tvInfoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_4"
            android:drawableStart="@drawable/clock"
            android:text=""
            android:textColor="@color/text_secondary_gray"
            android:textSize="@dimen/text_size_small" />

        <View
            android:id="@+id/dividerDurationGenre"
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_14"
            android:layout_marginHorizontal="@dimen/dp_12"
            android:background="@color/text_secondary_gray" />

        <TextView
            android:id="@+id/tvInfoGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_4"
            android:drawableStart="@drawable/ticket"
            android:text=""
            android:textColor="@color/text_secondary_gray"
            android:textSize="@dimen/text_size_small" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/text_size_small"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/layoutMovieInfo"
        app:tabIndicatorColor="@color/search_background"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="@dimen/dp_4"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="@color/text_secondary_gray" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
