<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/dp_140"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dp_14"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- CardView fills the exact width of its parent (140dp) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTrending"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_200"
        app:cardCornerRadius="@dimen/corner_radius_default"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivTrendingPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
    </androidx.cardview.widget.CardView>

    <!-- Rank sticks out visually using translation, doesn't affect item bounds -->
    <TextView
        android:id="@+id/tvTrendingRank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="@dimen/dp_10"
        android:includeFontPadding="false"
        android:shadowColor="@color/primary_blue"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8"
        android:textColor="@color/background_dark"
        android:textSize="@dimen/sp_90"
        android:textStyle="bold"
        android:translationY="@dimen/item_trending_text_translation_y"
        app:layout_constraintBottom_toBottomOf="@id/cardTrending"
        app:layout_constraintStart_toStartOf="@id/cardTrending" />

</androidx.constraintlayout.widget.ConstraintLayout>