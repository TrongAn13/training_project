<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        app:constraintSetStart="@id/start"
        app:constraintSetEnd="@id/end"
        app:duration="300">

        <!--
            touchAnchorId phải là direct child của MotionLayout.
            rvMovies là grandchild (nằm trong SwipeRefreshLayout) nên không dùng được.
            Dùng swipeRefreshHome là đúng — khi kéo lên, top của nó đi lên → progress tăng đúng chiều.
        -->
        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@id/swipeRefreshHome"
            app:touchAnchorSide="top"
            app:onTouchUp="autoComplete" />

        <KeyFrameSet>
            <!-- Header mờ dần từ frame 0–50, biến mất hoàn toàn trước khi transition kết thúc -->
            <KeyAttribute
                app:framePosition="50"
                app:motionTarget="@id/layoutTopHeader"
                android:alpha="0" />
        </KeyFrameSet>
    </Transition>

<!--     Trạng thái ban đầu: header hiện, tabs bên dưới header -->
    <ConstraintSet android:id="@id/start">
        <Constraint
            android:id="@id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@id/layoutFilterTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@id/swipeRefreshHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutFilterTabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </ConstraintSet>

    <!-- Trạng thái kết thúc: header ẩn lên trên, tabs neo lên đầu màn hình -->
    <ConstraintSet android:id="@id/end">
        <Constraint
            android:id="@id/layoutTopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@id/layoutFilterTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@id/swipeRefreshHome"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutFilterTabs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </ConstraintSet>

</MotionScene>
