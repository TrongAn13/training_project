<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <EditText
        android:id="@+id/etSearchInput"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_48"
        android:background="@drawable/button_blue_rounded"
        android:backgroundTint="@color/search_background"
        android:gravity="center_vertical"
        android:hint="@string/search_hint"
        android:paddingStart="@dimen/padding_medium"
        android:paddingEnd="@dimen/dp_48"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary_gray"
        android:textSize="@dimen/text_size_medium"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionSearch"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivSearchIcon"
        android:layout_width="@dimen/icon_size_small"
        android:layout_height="@dimen/icon_size_small"
        android:layout_marginEnd="@dimen/padding_medium"
        android:src="@drawable/ic_search2"
        app:layout_constraintBottom_toBottomOf="@id/etSearchInput"
        app:layout_constraintEnd_toEndOf="@id/etSearchInput"
        app:layout_constraintTop_toTopOf="@id/etSearchInput"
        app:tint="@color/text_secondary_gray" />

</merge>